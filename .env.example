# Variáveis do docker compose. Copie para `.env` (que o .gitignore já ignora)
# e preencha. As três primeiras não têm padrão: o compose recusa subir sem elas.
#
# Para gerar valores fortes:
#   PowerShell   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#   Linux/macOS  openssl rand -base64 32

# Senha do usuário da aplicação no PostgreSQL.
POSTGRES_PASSWORD=

# Segredo de assinatura do JWT. É a credencial mais sensível da pilha: quem o
# conhece forja um token de qualquer usuário, inclusive Admin, sem tocar no
# banco. Use um valor exclusivo deste ambiente — trocá-lo invalida as sessões.
JWT_SECRET=

# Admin inicial, criado na primeira subida (mínimo de 8 caracteres).
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@synergy.dev
SEED_ADMIN_NAME=Admin Synergy

# Porta em que o Synergy responde no host.
WEB_PORT=8080

# Duração da sessão, em horas.
JWT_TTL_HOURS=8

# SSO da Microsoft (opcional). Vazias = só login por e-mail e senha, e o botão
# nem aparece na tela. Os dois valores vêm do app registration no Entra e são
# usados tanto pela API quanto pelo build do front — ver README, seção 4.
MS_TENANT_ID=
MS_CLIENT_ID=

# Só necessário se o front for servido de outro domínio que não o da API.
CORS_ALLOWED_ORIGINS=
