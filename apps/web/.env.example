# URL base da API Go (apps/api)
VITE_API_URL=http://localhost:8080

# SSO da Microsoft (Entra ID) — opcional. Vazias = a tela de login mostra apenas
# e-mail e senha. Devem ser os MESMOS valores de MS_TENANT_ID e MS_CLIENT_ID da
# API: se divergirem, o token que o front obtém não passa na validação dela.
# São resolvidas no build (ver README, seção de deploy).
VITE_MS_TENANT_ID=
VITE_MS_CLIENT_ID=
