# Porta HTTP da API
API_PORT=8080

# Conexão com o PostgreSQL
DATABASE_URL=postgres://synergy:synergy@localhost:5432/synergy?sslmode=disable

# Segredo de assinatura do JWT (troque em qualquer ambiente real)
JWT_SECRET=troque-este-segredo-em-producao
JWT_TTL_HOURS=8

# Origens liberadas no CORS (o Vite sobe em 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Usadas apenas por `go run ./cmd/seed`
SEED_ADMIN_NAME=Admin Synergy
SEED_ADMIN_EMAIL=admin@synergy.dev
SEED_ADMIN_PASSWORD=synergy123
