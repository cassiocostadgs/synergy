# Porta HTTP da API
API_PORT=8080

# Conexão com o PostgreSQL
DATABASE_URL=postgres://synergy:synergy@localhost:5432/synergy?sslmode=disable

# Segredo de assinatura do JWT (troque em qualquer ambiente real)
JWT_SECRET=troque-este-segredo-em-producao
JWT_TTL_HOURS=8

# Origens liberadas no CORS (o Vite sobe em 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SSO da Microsoft (Entra ID) — opcional. Vazias = só login por senha.
# Vêm do app registration: Directory (tenant) ID e Application (client) ID, em
# GUID. Não são segredo (o front as embute no bundle), e não há client secret
# neste fluxo. As duas devem ser preenchidas juntas — a API recusa subir com
# apenas uma, para o SSO não ficar silenciosamente desligado.
MS_TENANT_ID=
MS_CLIENT_ID=

# Usadas apenas por `go run ./cmd/seed`
SEED_ADMIN_NAME=Admin Synergy
SEED_ADMIN_EMAIL=admin@synergy.dev
SEED_ADMIN_PASSWORD=synergy123
