# Contexto do build da imagem única (Dockerfile da raiz).
#
# Vale também para o .zip que se envia à plataforma: quanto menos entra, menor o
# upload e menor a chance de um segredo local viajar junto.

# Dependências e artefatos — a imagem reinstala e recompila tudo.
node_modules/
**/node_modules/
dist/
**/dist/
bin/
*.exe

# Segredos e configuração local.
#
# O .env DA RAIZ é a exceção e precisa entrar na imagem: o portal de deploy não
# injeta variável de ambiente no container — ele só faz o arquivo viajar no
# pacote. Quem o carrega é o docker-entrypoint.sh. Frameworks JS leem .env
# sozinhos no build; um binário Go não, então sem esta exceção a API sobe sem
# JWT_SECRET e a publicação é desfeita no healthcheck.
#
# Os .env de apps/api e apps/web continuam fora: são de desenvolvimento, e o de
# apps/web faria o Vite embutir http://localhost:8080 como URL da API.
**/.env
**/.env.*
!.env
!.env.example

# Histórico e ferramentas.
.git/
.github/
.vscode/
.idea/
.claude/

# Testes de ponta a ponta não entram na imagem de produção.
apps/e2e/
**/playwright-report/
**/test-results/

# Scripts de desenvolvimento do Windows.
apps/api/scripts/

# Documentação.
*.md
!README.md
